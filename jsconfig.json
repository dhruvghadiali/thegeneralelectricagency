{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@shadcnComponent/*": [
                "./src/components/ui/*"
            ],
            "@commonComponent/*": [
                "./src/components/common/*"
            ],
            "@screenComponent/*": [
                "./src/components/screen/*"
            ],
            "@Assets/*": [
                "./src/assets/*"
            ],
            "@Redux/*": [
                "./src/store/*"
            ],
            "@Enums/*": [
                "./src/enums/*"
            ],
            "@Enums": [
                "./src/enums/index.js"
            ],
            "@Forms/*": [
                "./src/forms/*"
            ],
            "@Tables/*": [
                "./src/tables/*"
            ],
            "@Api/*": [
                "./src/api/*"
            ],
            "@Api": [
                "./src/api/index.js"
            ],
        }
    },
    "include": ["./src/**/*"]
}
